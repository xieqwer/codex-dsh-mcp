# dependencies (the project has none at runtime, but keep this for local tools)
node_modules/

# build output (regenerated by `npm run build`)
dist/

# test scratch space and local logs
.tmp-tests/
*.log
.codex-dsh-mcp*.log
coverage/

# local config / secrets — never commit these
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# machine-specific words for the local privacy guard
privacy-patterns.local.json
